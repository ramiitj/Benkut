rules_version = '2';
service firebase.storage { match /b/{bucket}/o { match /households/{hid}/{allPaths=**} { allow read: if request.auth != null && firestore.exists(/databases/(default)/documents/households/$(hid)/members/$(request.auth.uid)); allow write: if request.auth != null && request.app != null && firestore.exists(/databases/(default)/documents/households/$(hid)/members/$(request.auth.uid)) && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('(image/(jpeg|png|webp)|audio/(webm|mpeg|wav)|video/(webm|mp4)|application/pdf)'); } } }
