ALLOWED_ORIGINS=
# Admin panel (/admin/*) login - required to enable it at all. There is no
# default; omitting either disables admin login entirely rather than
# falling back to a guessable credential.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Signs the admin session cookie (HMAC-SHA256) - required for admin login
# to work at all. Generate with: openssl rand -base64 32
BENKUT_ADMIN_SESSION_SECRET=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
GEMINI_API_KEY=
GEMINI_MODEL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=